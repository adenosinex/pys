# Set these through the terminal or the cloud platform's secret configuration.
# This file is documentation; the application does not load .env files automatically.
EXTRACTOR_API_KEY=replace-with-a-long-random-key
ZHIHU_COOKIE=d_c0=replace-with-your-value; z_c0=replace-with-your-value
# Alternative: ZHIHU_COOKIE_FILE=/run/secrets/zhihu-cookie
PORT=8000
MAX_CONCURRENCY=2
